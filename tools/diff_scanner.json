{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "name": "diff_scanner",
  "description": "Parses and inspects Git diffs or patches to extract changed files, added lines, and high-risk syntax patterns.",
  "parameters": {
    "type": "object",
    "properties": {
      "diff_text": {
        "type": "string",
        "description": "Unified git diff string to analyze"
      },
      "max_lines": {
        "type": "integer",
        "description": "Maximum number of lines to inspect",
        "default": 1000
      }
    },
    "required": ["diff_text"]
  },
  "returns": {
    "type": "object",
    "properties": {
      "files_changed": {
        "type": "array",
        "items": { "type": "string" }
      },
      "additions_count": { "type": "integer" },
      "deletions_count": { "type": "integer" },
      "suspicious_patterns": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "file": { "type": "string" },
            "line": { "type": "integer" },
            "issue": { "type": "string" },
            "snippet": { "type": "string" }
          }
        }
      }
    }
  }
}
