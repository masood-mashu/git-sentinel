{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "name": "secret_detector",
  "description": "Scans code, diffs, or text for leaked API keys, tokens, credentials, and high-entropy secrets.",
  "parameters": {
    "type": "object",
    "properties": {
      "content": {
        "type": "string",
        "description": "The text or diff content to scan for secrets"
      },
      "redact": {
        "type": "boolean",
        "description": "Whether to return redacted values for safety",
        "default": true
      }
    },
    "required": ["content"]
  },
  "returns": {
    "type": "object",
    "properties": {
      "secrets_found": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "type": { "type": "string" },
            "line": { "type": "integer" },
            "severity": { "type": "string" },
            "redacted_value": { "type": "string" }
          }
        }
      },
      "clean": { "type": "boolean" }
    }
  }
}
